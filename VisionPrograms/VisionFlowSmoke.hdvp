<body>


<c></c>








<l>create_data_code_2d_model ('Data Matrix ECC 200', [], [], DataCodeHandle)</l><l>find_data_code_2d (InputImage, SymbolXLDs, DataCodeHandle, [], [], ResultHandles, DecodedDataStrings)</l><l>if (|DecodedDataStrings|==1)</l><l>   IsOK:=true</l><l>   Decode_str := DecodedDataStrings</l><l>else</l><l>   IsOK:=false</l><l>   Decode_str:= ''</l><l>endif</l><l>return ()</l></body>
<docu id="VisionFlowSmoke">
<parameters>



