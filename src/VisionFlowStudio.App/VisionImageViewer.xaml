<UserControl x:Class="VisionFlowStudio.App.VisionImageViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B1120">
 <Grid>
  <Border x:Name="Viewport" ClipToBounds="True" Background="#0B1120" MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave" SizeChanged="Viewport_SizeChanged">
   <Canvas x:Name="ImageCanvas" ClipToBounds="True">
    <Image x:Name="ImageElement" Source="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor">
     <Image.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Image.RenderTransform>
    </Image>
   </Canvas>
  </Border>
  <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#CC0F172A" CornerRadius="4" Padding="9,5" Margin="8" IsHitTestVisible="False">
   <TextBlock x:Name="PixelInfo" Foreground="#E2E8F0" FontFamily="Consolas" Text="X: --  Y: --  Gray: --  Zoom: 100%"/>
  </Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
   <Button Content="适应" Click="Fit_Click" Padding="8,3"/><Button Content="1:1" Click="Actual_Click" Padding="8,3"/>
  </StackPanel>
 </Grid>
</UserControl>
