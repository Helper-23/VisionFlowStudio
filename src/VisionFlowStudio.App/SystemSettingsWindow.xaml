<Window x:Class="VisionFlowStudio.App.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Width="920" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F8FE">
    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="50"/><Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="48" Height="24" CornerRadius="12" Background="#CBD5E1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Margin="3" HorizontalAlignment="Left">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/></Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="8,11"/><Setter Property="BorderBrush" Value="#D8E8F7"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#123B63" Padding="20,0">
            <DockPanel><TextBlock Text="系统设置" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="VisionFlow Studio" Foreground="#BAE6FD" VerticalAlignment="Center"/></DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E4EFFA" BorderBrush="#C8DDF1" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,18,0,0">
                    <Border Background="#FFFFFF" BorderBrush="#0EA5E9" BorderThickness="4,0,0,0" Padding="22,15"><TextBlock Text="软件设置" FontSize="16" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="权限设置" FontSize="15" Foreground="#8AA0B5" Padding="26,16"/>
                    <TextBlock Text="方案设置" FontSize="15" Foreground="#8AA0B5" Padding="26,16"/>
                    <TextBlock Text="运行策略" FontSize="15" Foreground="#8AA0B5" Padding="26,16"/>
                    <TextBlock Text="采集策略" FontSize="15" Foreground="#8AA0B5" Padding="26,16"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,24">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="启动关闭设置" FontSize="20" FontWeight="SemiBold" Foreground="#173A5E" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="StartWithWindowsCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="开机软件自启动" FontSize="15" VerticalAlignment="Center"/></DockPanel></Border>
                    <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="StartMaximizedCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="启动时最大化" FontSize="15" VerticalAlignment="Center"/></DockPanel></Border>
                    <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="AutoLoadProjectCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="AutoLoadProject_Changed" Unchecked="AutoLoadProject_Changed"/><TextBlock Text="自动加载指定方案" FontSize="15" VerticalAlignment="Center"/></DockPanel></Border>

                    <Border x:Name="AutoLoadPanel" Background="#FFFFFF" BorderBrush="#BFD9EF" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="载入路径" VerticalAlignment="Center"/>
                            <TextBox x:Name="ProjectPathBox" Grid.Column="1" Margin="0,4" IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="…" Margin="5,4,0,4" Click="BrowseProject_Click" ToolTip="选择加密方案"/>
                            <TextBlock Grid.Row="1" Text="方案密码" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ProjectPasswordBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="密码使用 Windows 当前用户凭据保护，不会明文保存。" Foreground="#64748B" FontSize="12" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="语言与界面" FontSize="20" FontWeight="SemiBold" Foreground="#173A5E" Margin="0,28,0,10"/>
                    <Border Background="#FFFFFF" BorderBrush="#BFD9EF" BorderThickness="1" CornerRadius="6" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="界面语言" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
                                <ComboBoxItem Tag="en-US" Content="英语"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="语言切换会立即应用到当前窗口，并在下次启动时继续使用。" Foreground="#64748B" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="自动保存设置" FontSize="20" FontWeight="SemiBold" Foreground="#173A5E" Margin="0,28,0,10"/>
                    <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="AutoSaveProjectCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="AutoSaveProject_Changed" Unchecked="AutoSaveProject_Changed"/><TextBlock Text="自动保存方案" FontSize="15" VerticalAlignment="Center"/></DockPanel></Border>
                    <Border x:Name="AutoSavePanel" Background="#FFFFFF" BorderBrush="#BFD9EF" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="保存时间间隔" VerticalAlignment="Center"/>
                            <TextBox x:Name="AutoSaveIntervalBox" Grid.Column="1" Padding="8,6" HorizontalContentAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="分钟" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="仅保存已经指定路径和密码的加密项目；流程运行期间会自动顺延到下一次。" Foreground="#64748B" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="#E8F2FC" BorderBrush="#C8DDF1" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="86" IsCancel="True"/>
                <Button Content="确定" Width="86" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
