<Window x:Class="VisionFlowStudio.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VisionFlowStudio.App"
 Title="VisionFlow Studio" Width="1480" Height="900"
 MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="{StaticResource AppBackground}">
 <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="28"/><RowDefinition Height="42"/>
    <RowDefinition Height="*"/><RowDefinition Height="30"/>
   </Grid.RowDefinitions>

  <Menu Grid.Row="0" Background="{StaticResource PanelBrush}" VerticalContentAlignment="Center">
   <MenuItem Header="文件(_F)">
    <MenuItem Header="新建项目" Click="NewProject_Click" InputGestureText="Ctrl+N"/>
    <MenuItem Header="打开项目..." Click="OpenProject_Click" InputGestureText="Ctrl+O"/>
    <Separator/><MenuItem Header="保存项目" Click="SaveProject_Click" InputGestureText="Ctrl+S"/>
    <MenuItem Header="另存为项目..." Click="SaveProjectAs_Click"/>
    <Separator/><MenuItem Header="退出" Click="Exit_Click"/>
   </MenuItem>
   <MenuItem Header="项目(_P)">
    <MenuItem Header="项目属性" Click="ProjectSettings_Click"/>
    <MenuItem Header="型号 / 工位 / 相机 / 通信配置" Click="ProjectManagement_Click"/>
   </MenuItem>
   <MenuItem Header="流程(_W)">
    <MenuItem Header="新建流程" Click="NewFlow_Click" InputGestureText="Ctrl+Shift+N"/>
    <MenuItem Header="打开流程..." Click="OpenFlow_Click" InputGestureText="Ctrl+Shift+O"/>
    <MenuItem Header="保存流程" Click="SaveFlow_Click" InputGestureText="Ctrl+Shift+S"/>
    <MenuItem Header="另存为流程..." Click="SaveAsFlow_Click"/>
    <Separator/>
    <MenuItem Header="选择并添加节点..." Click="OpenNodePicker_Click"/>
    <MenuItem Header="添加 VisionMaster 节点" Click="AddVisionMasterNode_Click"/>
    <MenuItem Header="添加 VisionPro 节点" Click="AddVisionProNode_Click"/>
    <MenuItem Header="添加 HALCON 节点" Click="AddHalconNode_Click"/>
    <MenuItem Header="添加 C# 高级脚本节点" Click="AddScriptNode_Click"/>
    <MenuItem Header="添加通信写入节点" Click="AddCommunicationNode_Click"/>
    <Separator/><MenuItem Header="复制节点" Command="{Binding CopyNodeCommand}"/>
    <MenuItem Header="删除节点" Command="{Binding DeleteNodeCommand}"/>
    <MenuItem Header="上移" Command="{Binding MoveUpCommand}"/>
    <MenuItem Header="下移" Command="{Binding MoveDownCommand}"/>
    <MenuItem Header="启用/禁用" Command="{Binding ToggleNodeCommand}"/>
   </MenuItem>
   <MenuItem Header="运行(_R)">
    <MenuItem Header="单次运行整个流程" Command="{Binding RunAllCommand}"/>
    <MenuItem Header="连续运行" Command="{Binding RunContinuousCommand}"/>
    <MenuItem Header="启动通讯触发" Command="{Binding RunCommunicationTriggerCommand}"/>
    <MenuItem Header="单步运行" Command="{Binding RunSelectedCommand}"/>
    <MenuItem Header="从当前节点运行" Command="{Binding RunFromSelectedCommand}"/>
    <Separator/><MenuItem Header="停止" Command="{Binding StopCommand}"/>
   </MenuItem>
   <MenuItem Header="工具(_T)">
    <MenuItem Header="系统设置" Click="SystemSettings_Click"/>
    <Separator/>
    <MenuItem Header="工业相机管理" Click="CameraManager_Click"/>
    <MenuItem Header="通信配置" Click="CommunicationManager_Click"/>
    <MenuItem Header="视觉平台状态" Click="VisionMasterStatus_Click"/>
    <MenuItem Header="软件授权" Click="LicenseInformation_Click"/>
    <Separator/><MenuItem Header="打开运行数据目录" Click="OpenRunData_Click"/>
   </MenuItem>
   <MenuItem Header="帮助(_H)"><MenuItem Header="用户手册" Click="HelpContents_Click"/><MenuItem Header="快速入门" Click="QuickStart_Click"/><Separator/><MenuItem Header="关于" Click="About_Click"/></MenuItem>
  </Menu>
  <ToolBar Grid.Row="1" Background="#EFF8FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="8,3">
   <Button Content="＋ 选择节点" Click="OpenNodePicker_Click"/><Button Content="VM 节点" Click="AddVisionMasterNode_Click"/><Button Content="VP 节点" Click="AddVisionProNode_Click"/><Button Content="HALCON 节点" Click="AddHalconNode_Click"/><Button Content="C# 脚本" Click="AddScriptNode_Click"/><Button Content="通讯节点" Click="AddCommunicationNode_Click"/>
   <Button Content="复制" Command="{Binding CopyNodeCommand}"/><Button Content="删除" Command="{Binding DeleteNodeCommand}"/>
   <Separator/><Button Content="↑ 上移" Command="{Binding MoveUpCommand}"/><Button Content="↓ 下移" Command="{Binding MoveDownCommand}"/>
   <Button Content="启用/禁用" Command="{Binding ToggleNodeCommand}"/>
   <Separator/><Button Content="▶ 单次运行" Command="{Binding RunAllCommand}" Style="{StaticResource PrimaryButton}"/>
   <Button Content="⟳ 连续运行" Command="{Binding RunContinuousCommand}"/>
   <Button Content="⚡ 通讯触发" Command="{Binding RunCommunicationTriggerCommand}"/>
   <Button Content="▷ 单步" Command="{Binding RunSelectedCommand}"/><Button Content="⇥ 从当前运行" Command="{Binding RunFromSelectedCommand}"/>
   <Button Content="■ 停止" Command="{Binding StopCommand}"/>
  </ToolBar>

  <Grid Grid.Row="2" Margin="9">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="190" MinHeight="120"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="170"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="470"/><ColumnDefinition Width="5"/><ColumnDefinition Width="355" MinWidth="290"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="#BFDBFE" BorderThickness="1">
     <DockPanel><TextBlock DockPanel.Dock="Top" Text="项目结构" FontWeight="SemiBold" FontSize="13" Padding="13,11"/>
      <TreeView x:Name="ProjectTree" ItemsSource="{Binding ProjectTree}" Margin="7" BorderThickness="0" MouseDoubleClick="ProjectTree_MouseDoubleClick">
       <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:ProjectTreeNodeViewModel}" ItemsSource="{Binding Children}">
         <TextBlock Text="{Binding Header}" Padding="2"/>
        </HierarchicalDataTemplate>
       </TreeView.Resources>
       <TreeView.ItemContainerStyle>
       <Style TargetType="TreeViewItem">
         <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
         <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProjectTreeItem_PreviewMouseRightButtonDown"/>
        </Style>
       </TreeView.ItemContainerStyle>
      </TreeView>
     </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="#BFDBFE" BorderThickness="1">
     <TabControl x:Name="WorkspaceTabs" BorderThickness="0">
      <TabItem x:Name="FlowEditorTab" Header="流程编辑">
       <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EFF8FF" Padding="9"><StackPanel Orientation="Horizontal"><TextBlock Text="流程名称：" VerticalAlignment="Center"/><TextBox Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}" Width="190"/><TextBlock Text="  双击单元格可编辑，右侧可修改完整参数" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel></Border>
        <DataGrid ItemsSource="{Binding FlowSteps}" SelectedItem="{Binding SelectedNode}" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False">
         <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="45" IsReadOnly="True"/>
          <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55"/>
          <DataGridTextColumn Header="节点名称" Binding="{Binding DisplayNodeName}" Width="160"/>
          <DataGridTextColumn Header="类型" Binding="{Binding NodeType}" Width="175" IsReadOnly="True"/>
          <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="95" IsReadOnly="True"/>
          <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus}" Width="78" IsReadOnly="True"/>
          <DataGridTextColumn Header="耗时" Binding="{Binding Cost}" Width="82" IsReadOnly="True"/>
          <DataGridTextColumn Header="信息" Binding="{Binding DisplayMessage}" Width="*" IsReadOnly="True"/>
         </DataGrid.Columns>
        </DataGrid>
       </DockPanel>
      </TabItem>
      <TabItem Header="图像与结果">
       <TabControl BorderThickness="0">
        <TabItem Header="多画面监控">
         <DockPanel Background="#EAF4FF">
           <Border DockPanel.Dock="Top" Background="#F8FBFF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="10,7">
           <DockPanel>
            <TextBlock Text="所有工站 / 型号 / 流程画面" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
             <TextBlock Text="{Binding ImageDocumentCountText}" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
             <Button Content="弹出选中画面" Click="OpenSelectedImageWindow_Click" Padding="10,4"/>
            </StackPanel>
           </DockPanel>
          </Border>
          <ListBox ItemsSource="{Binding ImageDocuments}" SelectedItem="{Binding SelectedImageDocument}" BorderThickness="0" Background="#EAF4FF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid/></ItemsPanelTemplate>
           </ListBox.ItemsPanel>
           <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
             <Setter Property="Margin" Value="6"/>
             <Setter Property="MinWidth" Value="320"/>
             <Setter Property="MinHeight" Value="220"/>
             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
             <Setter Property="VerticalContentAlignment" Value="Stretch"/>
             <EventSetter Event="MouseDoubleClick" Handler="ImageDocumentItem_MouseDoubleClick"/>
            </Style>
           </ListBox.ItemContainerStyle>
           <ListBox.ItemTemplate>
            <DataTemplate>
             <Border Background="#F8FBFF" BorderBrush="#BBD7F0" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
              <Grid>
               <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
               <Border Background="#E0F2FE" Padding="9,0"><TextBlock Text="{Binding Title}" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
               <local:VisionImageViewer Grid.Row="1" Source="{Binding Source}"/>
               <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,5" Background="#CC0F172A" CornerRadius="4"><TextBlock Text="{Binding ResultState}" Foreground="#047857" FontSize="15" FontWeight="Bold"/></Border>
               <Border Grid.Row="2" Padding="9,6" Background="#F1F8FF" BorderBrush="#B9DDF8" BorderThickness="0,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                 <TextBlock Text="{Binding DisplayResultMessage}" Foreground="#335C81" TextTrimming="CharacterEllipsis"/>
                 <TextBlock Grid.Column="1" Text="{Binding CycleTime}" Foreground="#0369A1" Margin="12,0,0,0"/>
                </Grid>
               </Border>
              </Grid>
             </Border>
            </DataTemplate>
           </ListBox.ItemTemplate>
          </ListBox>
         </DockPanel>
        </TabItem>
        <TabItem Header="单画面查看">
       <TabControl ItemsSource="{Binding ImageDocuments}" SelectedItem="{Binding SelectedImageDocument}" BorderThickness="0">
        <TabControl.ItemTemplate>
         <DataTemplate><TextBlock Text="{Binding Title}" Padding="6,2"/></DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
         <DataTemplate>
          <Grid Background="#EAF4FF"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <local:VisionImageViewer Grid.Row="0" Source="{Binding Source}"/>
           <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="14,8" Background="#CC0F172A" CornerRadius="5"><TextBlock Text="{Binding ResultState}" Foreground="#047857" FontSize="18" FontWeight="Bold"/></Border>
           <Border Grid.Row="1" Margin="0" Padding="10,8" Background="#F1F8FF" BorderBrush="#B9DDF8" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayResultMessage}" Foreground="#335C81"/><TextBlock Grid.Column="1" Text="{Binding CycleTime}" Foreground="#0369A1" Margin="15,0"/></Grid></Border>
          </Grid>
         </DataTemplate>
        </TabControl.ContentTemplate>
        </TabControl>
        </TabItem>
       </TabControl>
      </TabItem>
     </TabControl>
    </Border>
    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

    <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="#BFDBFE" BorderThickness="1">
     <TabControl BorderThickness="0">
      <TabItem Header="节点属性">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13" DataContext="{Binding SelectedNode}">
        <TextBlock Text="节点名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding DisplayNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,9"/>
        <TextBlock Text="节点类型" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding DataContext.AvailableNodeTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding NodeType}" Margin="0,4,0,9"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="类别" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding DisplayCategory}"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="平台" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding DataContext.AvailablePlatforms, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Platform}"/></StackPanel></Grid>
        <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="启用节点" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="超时(ms)" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding TimeoutMs}"/></StackPanel></Grid>
        <TextBlock Text="错误策略" Foreground="{StaticResource MutedBrush}"/><ComboBox SelectedValue="{Binding OnError}" SelectedValuePath="Content" Margin="0,4,0,10"><ComboBoxItem Content="StopFlow"/><ComboBoxItem Content="Continue"/></ComboBox>
        <TextBlock Text="通用运行条件（可选）" FontWeight="SemiBold" Margin="0,4,0,4"/>
        <TextBlock Text="在节点参数中配置 RunWhenKey、RunWhenMode、RunWhenValue。示例：CommunicationTrigger.Camera / Equals / A。未满足时该节点跳过。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="节点参数" FontWeight="SemiBold" Margin="0,5"/>
        <StackPanel Margin="0,0,0,8">
         <StackPanel.Style>
          <Style TargetType="StackPanel">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding NodeType}" Value="LimitJudgeNode"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </StackPanel.Style>
         <TextBlock Text="判定数据源" Foreground="{StaticResource MutedBrush}"/>
         <ComboBox ItemsSource="{Binding DataContext.AvailableJudgeDataSources, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding LimitJudgeInputKey, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True" Margin="0,4,0,8"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,5,0"><TextBlock Text="下限 Min" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding LimitJudgeMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="上限 Max" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding LimitJudgeMax, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         </Grid>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Parameters}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="190">
         <DataGrid.Style>
          <Style TargetType="DataGrid">
           <Setter Property="Visibility" Value="Visible"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding NodeType}" Value="LimitJudgeNode"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </DataGrid.Style>
         <DataGrid.Columns><DataGridTextColumn Header="参数名" Binding="{Binding Key}" Width="135"/><DataGridTextColumn Header="值" Binding="{Binding DisplayValue}" Width="*"/></DataGrid.Columns>
        </DataGrid>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="VisionMaster">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13">
        <TextBlock Text="Solution 文件" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SolutionPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="浏览" Click="BrowseSolution_Click"/></Grid>
        <TextBlock Text="密码" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="SolutionPasswordBox" PasswordChanged="SolutionPasswordBox_PasswordChanged" Padding="8,6" Margin="0,4,0,8"/>
        <TextBlock Text="流程名称" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Procedures}" Text="{Binding SelectedProcedure, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,4,0,8"/>
        <TextBlock Text="测试图像（可选）" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="浏览" Click="BrowseImage_Click"/></Grid>
        <TextBlock Text="流程图像来源（测试图像留空时使用）" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding AvailableImageSources}" SelectedItem="{Binding SelectedImageSourceKey}" IsEditable="True" Margin="0,4,0,8"/>
        <TextBlock Text="动态图像输入名" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding ImageInputName}" Margin="0,4,0,8"/>
        <TextBlock Text="OK 输出名（可留空）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding OkOutputName}" Margin="0,4,0,10"/>
        <WrapPanel><Button Content="加载 Solution" Command="{Binding LoadSolutionCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="打开 VM 调试窗口" Click="OpenVisionMasterDebug_Click"/><Button Content="测试运行" Command="{Binding RunCommand}"/><Button Content="关闭" Command="{Binding CloseSolutionCommand}"/></WrapPanel>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="VisionPro">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13">
        <TextBlock Text="ToolBlock VPP" Foreground="{StaticResource MutedBrush}"/>
        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding VisionProToolBlockPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="浏览" Click="BrowseVpp_Click"/></Grid>
        <TextBlock Text="测试图像（可选）" Foreground="{StaticResource MutedBrush}"/>
        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="浏览" Click="BrowseImage_Click"/></Grid>
        <TextBlock Text="流程图像来源（测试图像留空时使用）" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding AvailableImageSources}" SelectedItem="{Binding SelectedImageSourceKey}" IsEditable="True" Margin="0,4,0,8"/>
        <TextBlock Text="图像输入名" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding VisionProImageInputName}" Margin="0,4,0,8"/>
        <TextBlock Text="OK 输出名" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding VisionProOkOutputName}" Margin="0,4,0,10"/>
        <WrapPanel><Button Content="打开 CogToolBlockEditV2" Click="OpenVisionProDebug_Click" Style="{StaticResource PrimaryButton}"/><Button Content="运行选中节点" Command="{Binding RunSelectedCommand}"/></WrapPanel>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="HALCON">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13">
        <TextBlock Text="External Procedure (.hdvp)" Foreground="{StaticResource MutedBrush}"/>
        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding HalconProcedurePath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="浏览" Click="BrowseHalconProcedure_Click"/></Grid>
        <TextBlock Text="测试图像（可选）" Foreground="{StaticResource MutedBrush}"/>
        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="浏览" Click="BrowseImage_Click"/></Grid>
        <TextBlock Text="流程图像来源（测试图像留空时使用）" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding AvailableImageSources}" SelectedItem="{Binding SelectedImageSourceKey}" IsEditable="True" Margin="0,4,0,8"/>
        <TextBlock Text="图像输入名" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding HalconImageInputName}" Margin="0,4,0,8"/>
        <TextBlock Text="OK 输出名（可留空）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding HalconOkOutputName}" Margin="0,4,0,10"/>
        <TextBlock Text="控制参数请在节点参数表中添加 Input.参数名" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <WrapPanel><Button Content="打开 HDVP 脚本调试" Click="OpenHalconDebug_Click" Style="{StaticResource PrimaryButton}"/><Button Content="运行选中节点" Command="{Binding RunSelectedCommand}"/></WrapPanel>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="C# 脚本">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13">
        <TextBlock Text="C# 高级脚本节点" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="支持 Roslyn 编译、语义智能提示、编译诊断、外部 DLL 引用，以及访问当前流程中任意节点的输入与输出。脚本声明的输出也可供后续节点和通讯节点选择。"/>
        <WrapPanel><Button Content="打开脚本编辑器" Click="OpenScriptEditor_Click" Style="{StaticResource PrimaryButton}"/><Button Content="运行选中节点" Command="{Binding RunSelectedCommand}"/></WrapPanel>
        <Separator Margin="0,12,0,8"/>
        <TextBlock Text="常用 API" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap" Text="Get&lt;T&gt;(&quot;节点.输出&quot;)&#x0a;GetNodeOutput&lt;T&gt;(&quot;节点&quot;, &quot;输出&quot;)&#x0a;GetNodeInput&lt;T&gt;(&quot;节点&quot;, &quot;输入&quot;)&#x0a;Tool(&quot;节点&quot;).Inputs / Outputs&#x0a;SetOutput(&quot;名称&quot;, value)"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="通讯">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13">
        <TextBlock Text="通信通道" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding AvailableCommunicationChannels}" SelectedItem="{Binding CommunicationChannel}" IsEditable="True" Margin="0,4,0,8"/>
        <TextBlock Text="多项结果写入映射" FontWeight="SemiBold" Margin="0,4,0,5"/>
        <DataGrid ItemsSource="{Binding CommunicationWrites}" SelectedItem="{Binding SelectedCommunicationWrite}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="230" Margin="0,0,0,8">
         <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
          <DataGridTemplateColumn Header="流程输出" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AvailableDataSources, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding SourceKey, UpdateSourceTrigger=LostFocus}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridCheckBoxColumn Header="常量" Binding="{Binding UseConstant, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
          <DataGridTextColumn Header="常量值" Binding="{Binding ConstantValue, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
          <DataGridTextColumn Header="PLC地址 / TCP模板 / JSON路径" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
          <DataGridTemplateColumn Header="数据类型" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AvailableCommunicationDataTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <WrapPanel><Button Content="+添加写入" Click="AddCommunicationWrite_Click" Style="{StaticResource PrimaryButton}"/><Button Content="删除写入" Click="RemoveCommunicationWrite_Click"/><Button Content="添加通讯节点" Click="AddCommunicationNode_Click"/><Button Content="运行选中节点" Command="{Binding RunSelectedCommand}"/><Button Content="管理通信通道" Click="CommunicationManager_Click"/></WrapPanel>
        <Separator Margin="0,12,0,8"/>
        <TextBlock Text="流程运行与通信触发" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Text="连续间隔(ms)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ContinuousIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
         <TextBlock Grid.Row="1" Text="触发通道" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableCommunicationChannels}" SelectedItem="{Binding TriggerChannel}" IsEditable="True" Margin="0,2"/>
         <TextBlock Grid.Row="2" Text="{Binding TriggerAddressLabel}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TriggerAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPlcTriggerChannel}" Margin="0,2"/>
         <TextBlock Grid.Row="3" Text="{Binding TriggerDataTypeLabel}" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableTriggerDataTypes}" SelectedItem="{Binding TriggerDataType}" IsEnabled="{Binding IsPlcTriggerChannel}" Margin="0,2"/>
         <TextBlock Grid.Row="4" Text="触发方式" VerticalAlignment="Center"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableTriggerModes}" SelectedItem="{Binding TriggerMode}" Margin="0,2"/>
         <TextBlock Grid.Row="5" Text="触发匹配字段" VerticalAlignment="Center"/><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding AvailableTriggerMatchFields}" SelectedItem="{Binding TriggerMatchField}" IsEnabled="{Binding IsTcpTriggerChannel}" IsEditable="True" Margin="0,2" ToolTip="留空时匹配完整接收帧"/>
         <TextBlock Grid.Row="6" Text="{Binding TriggerExpectedValueLabel}" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TriggerExpectedValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
         <TextBlock Grid.Row="7" Text="轮询周期(ms)" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TriggerPollIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
        </Grid>
        <TextBlock Text="{Binding TriggerHelpText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <TextBlock Text="TCP 接收字段提取" FontWeight="SemiBold" Margin="0,10,0,5"/>
        <DataGrid ItemsSource="{Binding CommunicationTriggerFields}" SelectedItem="{Binding SelectedTriggerField}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding IsTcpTriggerChannel}" MinHeight="150" Margin="0,0,0,5">
         <DataGrid.Columns>
          <DataGridTextColumn Header="字段名 / 数据Key" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
          <DataGridTemplateColumn Header="提取方式" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AvailableCommunicationFieldModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="字段序号(0起)" Binding="{Binding FieldIndex, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
          <DataGridTextColumn Header="起始位置(0起)" Binding="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
          <DataGridTextColumn Header="长度(0到末尾)" Binding="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
          <DataGridTextColumn Header="JSON路径" Binding="{Binding JsonPath, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
          <DataGridCheckBoxColumn Header="可选" Binding="{Binding Optional, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
          <DataGridCheckBoxColumn Header="去空白" Binding="{Binding Trim, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
         </DataGrid.Columns>
        </DataGrid>
        <WrapPanel><Button Content="+添加提取字段" Click="AddCommunicationTriggerField_Click" IsEnabled="{Binding IsTcpTriggerChannel}"/><Button Content="删除提取字段" Click="RemoveCommunicationTriggerField_Click" IsEnabled="{Binding IsTcpTriggerChannel}"/></WrapPanel>
        <TextBlock Text="分隔提取：字段序号从 0 开始；位置提取按解码字符计算；JSON 路径示例 Command、Data.Center1.X、Data.Trajectory[0].X。脚本可使用 Get&lt;string&gt;(&quot;CommunicationTrigger.字段名&quot;)。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <TextBlock Text="可选配方切换" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <Grid IsEnabled="{Binding IsTcpTriggerChannel}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Text="命令字段" VerticalAlignment="Center"/><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableTriggerMatchFields}" SelectedItem="{Binding RecipeSwitchCommandField}" IsEditable="True" Margin="0,2"/>
         <TextBlock Grid.Row="1" Text="切换命令值" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecipeSwitchCommandValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
         <TextBlock Grid.Row="2" Text="配方值字段" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableTriggerMatchFields}" SelectedItem="{Binding RecipeSwitchValueField}" IsEditable="True" Margin="0,2"/>
        </Grid>
        <TextBlock Text="配方值可匹配型号名称、产品编码，或使用从 0 开始的型号序号。命令/值字段留空时禁用此功能。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="TCP 文本字段模式会合并为一帧；JSON 模式把每行“JSON路径”组装成嵌套对象。勾选常量可发送 Command、Result 等固定值；$Now/$UtcNow 可作为动态时间数据源。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="单次运行" Command="{Binding RunAllCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="连续运行" Command="{Binding RunContinuousCommand}"/><Button Content="启动通信触发" Command="{Binding RunCommunicationTriggerCommand}"/><Button Content="停止" Command="{Binding StopCommand}"/></WrapPanel>
       </StackPanel></ScrollViewer>
      </TabItem>
     </TabControl>
    </Border>
   </Grid>
   <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
   <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="#BFDBFE" BorderThickness="1">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="运行日志" FontWeight="SemiBold" Padding="12,8"/><DataGrid ItemsSource="{Binding Logs}" IsReadOnly="True" AutoGenerateColumns="False" Background="#FFFFFF" Foreground="#0F172A" RowBackground="#FFFFFF" AlternatingRowBackground="#F3F9FF"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="110"/><DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="80"/><DataGridTextColumn Header="消息" Binding="{Binding DisplayMessage}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#DFF2FF" BorderBrush="#B9DDF8" BorderThickness="0,1,0,0" Padding="12,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding ProjectStatusText}" Foreground="#335C81" VerticalAlignment="Center"/>
    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="9,2" Margin="6,0">
     <TextBlock Text="{Binding PlatformMessageDisplay}" Foreground="#0369A1" VerticalAlignment="Center"/>
    </Border>
    <Border Grid.Column="2" Background="#E0F2FE" BorderBrush="#7DD3FC" BorderThickness="1" CornerRadius="11" Padding="9,2" Margin="6,0">
     <TextBlock Text="{Binding RunStateDisplay}" Foreground="#047857" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Grid.Column="3" Text="{Binding CurrentFlowStatusText}" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="4" Text="{Binding CurrentTimeText}" Foreground="#335C81" Margin="16,0,0,0" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
